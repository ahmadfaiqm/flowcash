generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["accounting", "cashbank", "inventory", "sales", "purchase", "asset"]
}

// ========== ENUMS (shared, stored in accounting schema) ==========
enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense

  @@schema("accounting")
}

enum JournalStatus {
  draft
  posted
  void

  @@schema("accounting")
}

enum InvoiceStatus {
  draft
  unpaid
  partial
  paid
  void

  @@schema("accounting")
}

enum PaymentMethod {
  cash
  transfer
  qris
  giro
  other

  @@schema("accounting")
}

// ========== ACCOUNTING SCHEMA (inti_akuntansi) ==========

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar
  email        String   @unique @db.VarChar
  passwordHash String   @map("password_hash") @db.VarChar
  role         String   @default("admin") @db.VarChar
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  businessProfiles BusinessProfile[]
  journals         Journal[]

  @@map("users")
  @@schema("accounting")
}

model BusinessProfile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  businessName String   @map("business_name") @db.VarChar
  address      String?  @db.Text
  phone        String?  @db.VarChar
  taxId        String?  @map("tax_id") @db.VarChar
  baseCurrency String   @default("IDR") @map("base_currency") @db.VarChar
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
  @@schema("accounting")
}

model ChartOfAccount {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String      @unique @db.VarChar
  name       String      @db.VarChar
  type       AccountType
  parentId   String?     @map("parent_id") @db.Uuid
  isCashBank Boolean     @default(false) @map("is_cash_bank")
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamp(6)

  parent   ChartOfAccount?  @relation("CoAParent", fields: [parentId], references: [id])
  children ChartOfAccount[] @relation("CoAParent")

  taxes                   Tax[]
  journalLines            JournalLine[]
  cashBankAccounts        CashBankAccount[]
  // inventory relations
  productInventories      Product[]         @relation("ProductInventoryCoA")
  productSales            Product[]         @relation("ProductSalesCoA")
  productCogs             Product[]         @relation("ProductCogsCoA")
  // sales / purchase sub-ledger
  customerReceivables     Customer[]        @relation("CustomerReceivableCoA")
  supplierPayables        Supplier[]        @relation("SupplierPayableCoA")
  // fixed asset
  fixedAssetAssets        FixedAsset[]      @relation("FixedAssetAssetCoA")
  fixedAssetDepreciations FixedAsset[]      @relation("FixedAssetDepreciationCoA")
  fixedAssetAccumulated   FixedAsset[]      @relation("FixedAssetAccumulatedCoA")

  @@index([type])
  @@map("chart_of_accounts")
  @@schema("accounting")
}

model Tax {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String  @unique @db.VarChar
  name     String  @db.VarChar
  rate     Decimal @default(0) @db.Decimal(5, 2)
  coaId    String? @map("coa_id") @db.Uuid
  isActive Boolean @default(true) @map("is_active")

  coa              ChartOfAccount?   @relation(fields: [coaId], references: [id])
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]

  @@map("taxes")
  @@schema("accounting")
}

model Journal {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalNo     String        @unique @map("journal_no") @db.VarChar
  date          DateTime      @db.Date
  description   String?       @db.Text
  referenceType String?       @map("reference_type") @db.VarChar
  referenceId   String?       @map("reference_id") @db.Uuid
  status        JournalStatus @default(draft)
  createdBy     String?       @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  creator            User?               @relation(fields: [createdBy], references: [id])
  lines              JournalLine[]
  salesInvoices      SalesInvoice[]
  receipts           Receipt[]
  purchaseInvoices   PurchaseInvoice[]
  purchasePayments   PurchasePayment[]
  assetDepreciations AssetDepreciation[]

  @@index([date])
  @@index([referenceType, referenceId])
  @@map("journals")
  @@schema("accounting")
}

model JournalLine {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalId String  @map("journal_id") @db.Uuid
  coaId     String  @map("coa_id") @db.Uuid
  debit     Decimal @default(0) @db.Decimal(15, 2)
  credit    Decimal @default(0) @db.Decimal(15, 2)
  memo      String? @db.VarChar

  journal Journal        @relation(fields: [journalId], references: [id], onDelete: Cascade)
  coa     ChartOfAccount @relation(fields: [coaId], references: [id])

  @@index([journalId])
  @@index([coaId])
  @@map("journal_lines")
  @@schema("accounting")
}

// ========== CASHBANK SCHEMA (kas_bank) ==========

model CashBankAccount {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coaId          String  @unique @map("coa_id") @db.Uuid
  bankName       String  @map("bank_name") @db.VarChar
  accountNumber  String? @map("account_number") @db.VarChar
  openingBalance Decimal @default(0) @map("opening_balance") @db.Decimal(15, 2)
  isActive       Boolean @default(true) @map("is_active")

  coa              ChartOfAccount    @relation(fields: [coaId], references: [id])
  salesInvoices    SalesInvoice[]
  receipts         Receipt[]
  purchasePayments PurchasePayment[]

  @@map("cash_bank_accounts")
  @@schema("cashbank")
}

// ========== INVENTORY SCHEMA (stok) ==========

model Product {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku            String  @unique @db.VarChar
  name           String  @db.VarChar
  unit           String  @default("pcs") @db.VarChar
  purchasePrice  Decimal @default(0) @map("purchase_price") @db.Decimal(15, 2)
  sellPrice      Decimal @default(0) @map("sell_price") @db.Decimal(15, 2)
  avgCost        Decimal @default(0) @map("avg_cost") @db.Decimal(15, 2)
  stockQty       Decimal @default(0) @map("stock_qty") @db.Decimal(12, 2)
  coaInventoryId String? @map("coa_inventory_id") @db.Uuid
  coaSalesId     String? @map("coa_sales_id") @db.Uuid
  coaCogsId      String? @map("coa_cogs_id") @db.Uuid
  isActive       Boolean @default(true) @map("is_active")

  coaInventory ChartOfAccount? @relation("ProductInventoryCoA", fields: [coaInventoryId], references: [id])
  coaSales     ChartOfAccount? @relation("ProductSalesCoA", fields: [coaSalesId], references: [id])
  coaCogs      ChartOfAccount? @relation("ProductCogsCoA", fields: [coaCogsId], references: [id])

  stockMovements       StockMovement[]
  salesInvoiceLines    SalesInvoiceLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]

  @@map("products")
  @@schema("inventory")
}

model StockMovement {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  date          DateTime @db.Date
  type          String   @db.VarChar
  qty           Decimal  @db.Decimal(12, 2)
  unitCost      Decimal  @default(0) @map("unit_cost") @db.Decimal(15, 2)
  referenceType String?  @map("reference_type") @db.VarChar
  referenceId   String?  @map("reference_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([date])
  @@map("stock_movements")
  @@schema("inventory")
}

// ========== SALES SCHEMA (penjualan_ar) ==========

model Customer {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique @db.VarChar
  name            String   @db.VarChar
  phone           String?  @db.VarChar
  address         String?  @db.Text
  receivableCoaId String?  @map("receivable_coa_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  receivableCoA ChartOfAccount? @relation("CustomerReceivableCoA", fields: [receivableCoaId], references: [id])
  salesInvoices SalesInvoice[]

  @@map("customers")
  @@schema("sales")
}

model SalesInvoice {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNo  String        @unique @map("invoice_no") @db.VarChar
  customerId String        @map("customer_id") @db.Uuid
  date       DateTime      @db.Date
  dueDate    DateTime?     @map("due_date") @db.Date
  taxId      String?       @map("tax_id") @db.Uuid
  taxAmount  Decimal       @default(0) @map("tax_amount") @db.Decimal(15, 2)
  subtotal   Decimal       @default(0) @db.Decimal(15, 2)
  grandTotal Decimal       @map("grand_total") @db.Decimal(15, 2)
  paidTotal  Decimal       @default(0) @map("paid_total") @db.Decimal(15, 2)
  status     InvoiceStatus @default(unpaid)
  journalId  String?       @map("journal_id") @db.Uuid
  cashBankId String?       @map("cash_bank_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  customer Customer         @relation(fields: [customerId], references: [id])
  tax      Tax?             @relation(fields: [taxId], references: [id])
  journal  Journal?         @relation(fields: [journalId], references: [id])
  cashBank CashBankAccount? @relation(fields: [cashBankId], references: [id])

  lines    SalesInvoiceLine[]
  receipts Receipt[]

  @@map("sales_invoices")
  @@schema("sales")
}

model SalesInvoiceLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salesInvoiceId String  @map("sales_invoice_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid
  description    String  @db.VarChar
  qty            Decimal @db.Decimal(12, 2)
  price          Decimal @db.Decimal(15, 2)
  lineTotal      Decimal @map("line_total") @db.Decimal(15, 2)

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id])

  @@map("sales_invoice_lines")
  @@schema("sales")
}

model Receipt {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptNo      String        @unique @map("receipt_no") @db.VarChar
  salesInvoiceId String        @map("sales_invoice_id") @db.Uuid
  date           DateTime      @db.Date
  amount         Decimal       @db.Decimal(15, 2)
  method         PaymentMethod @default(transfer)
  cashBankId     String        @map("cash_bank_id") @db.Uuid
  journalId      String?       @map("journal_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  salesInvoice SalesInvoice    @relation(fields: [salesInvoiceId], references: [id])
  cashBank     CashBankAccount @relation(fields: [cashBankId], references: [id])
  journal      Journal?        @relation(fields: [journalId], references: [id])

  @@map("receipts")
  @@schema("sales")
}

// ========== PURCHASE SCHEMA (pembelian_ap) ==========

model Supplier {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar
  name         String   @db.VarChar
  phone        String?  @db.VarChar
  address      String?  @db.Text
  payableCoaId String?  @map("payable_coa_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  payableCoA       ChartOfAccount?   @relation("SupplierPayableCoA", fields: [payableCoaId], references: [id])
  purchaseInvoices PurchaseInvoice[]

  @@map("suppliers")
  @@schema("purchase")
}

model PurchaseInvoice {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNo  String        @unique @map("invoice_no") @db.VarChar
  supplierId String        @map("supplier_id") @db.Uuid
  date       DateTime      @db.Date
  dueDate    DateTime?     @map("due_date") @db.Date
  taxId      String?       @map("tax_id") @db.Uuid
  taxAmount  Decimal       @default(0) @map("tax_amount") @db.Decimal(15, 2)
  subtotal   Decimal       @default(0) @db.Decimal(15, 2)
  grandTotal Decimal       @map("grand_total") @db.Decimal(15, 2)
  paidTotal  Decimal       @default(0) @map("paid_total") @db.Decimal(15, 2)
  status     InvoiceStatus @default(unpaid)
  journalId  String?       @map("journal_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  supplier Supplier @relation(fields: [supplierId], references: [id])
  tax      Tax?     @relation(fields: [taxId], references: [id])
  journal  Journal? @relation(fields: [journalId], references: [id])

  lines    PurchaseInvoiceLine[]
  payments PurchasePayment[]

  @@map("purchase_invoices")
  @@schema("purchase")
}

model PurchaseInvoiceLine {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseInvoiceId String  @map("purchase_invoice_id") @db.Uuid
  productId         String? @map("product_id") @db.Uuid
  description       String  @db.VarChar
  qty               Decimal @db.Decimal(12, 2)
  price             Decimal @db.Decimal(15, 2)
  lineTotal         Decimal @map("line_total") @db.Decimal(15, 2)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id])

  @@map("purchase_invoice_lines")
  @@schema("purchase")
}

model PurchasePayment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentNo         String        @unique @map("payment_no") @db.VarChar
  purchaseInvoiceId String        @map("purchase_invoice_id") @db.Uuid
  date              DateTime      @db.Date
  amount            Decimal       @db.Decimal(15, 2)
  method            PaymentMethod @default(transfer)
  cashBankId        String        @map("cash_bank_id") @db.Uuid
  journalId         String?       @map("journal_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  cashBank        CashBankAccount @relation(fields: [cashBankId], references: [id])
  journal         Journal?        @relation(fields: [journalId], references: [id])

  @@map("purchase_payments")
  @@schema("purchase")
}

// ========== ASSET SCHEMA (aset) ==========

model FixedAsset {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String   @unique @db.VarChar
  name              String   @db.VarChar
  purchaseDate      DateTime @map("purchase_date") @db.Date
  purchaseCost      Decimal  @map("purchase_cost") @db.Decimal(15, 2)
  usefulLifeMonths  Int      @map("useful_life_months")
  salvageValue      Decimal  @default(0) @map("salvage_value") @db.Decimal(15, 2)
  coaAssetId        String?  @map("coa_asset_id") @db.Uuid
  coaDepreciationId String?  @map("coa_depreciation_id") @db.Uuid
  coaAccumulatedId  String?  @map("coa_accumulated_id") @db.Uuid
  isActive          Boolean  @default(true) @map("is_active")

  coaAsset        ChartOfAccount? @relation("FixedAssetAssetCoA", fields: [coaAssetId], references: [id])
  coaDepreciation ChartOfAccount? @relation("FixedAssetDepreciationCoA", fields: [coaDepreciationId], references: [id])
  coaAccumulated  ChartOfAccount? @relation("FixedAssetAccumulatedCoA", fields: [coaAccumulatedId], references: [id])

  depreciations AssetDepreciation[]

  @@map("fixed_assets")
  @@schema("asset")
}

model AssetDepreciation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fixedAssetId String   @map("fixed_asset_id") @db.Uuid
  period       DateTime @db.Date
  amount       Decimal  @db.Decimal(15, 2)
  journalId    String?  @map("journal_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  fixedAsset FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)
  journal    Journal?   @relation(fields: [journalId], references: [id])

  @@unique([fixedAssetId, period])
  @@map("asset_depreciations")
  @@schema("asset")
}
